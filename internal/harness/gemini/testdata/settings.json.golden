{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "aim",
            "type": "command",
            "command": "/opt/aim hook gemini",
            "timeout": 10000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "aim",
            "type": "command",
            "command": "/opt/aim hook gemini",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "aim",
            "type": "command",
            "command": "/opt/aim hook gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "aim",
            "type": "command",
            "command": "/opt/aim hook gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "aim",
            "type": "command",
            "command": "/opt/aim hook gemini",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
